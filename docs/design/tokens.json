{
  "$description": "Campus++ design tokens. Three layers: core (raw values) -> themes (what each value is used for, in light and dark) -> component (how buttons, inputs and cards use them). A value wrapped in curly brackets points to another token.",
  "meta": {
    "name": "Campus++ Design Tokens",
    "version": "1.0.0",
    "description": "A trustworthy campus design system with a blackberry-purple brand, turquoise accents, balanced spacing, and light and dark themes."
  },

  "core": {
    "color": {
      "blackberry":     { "$value": "#4A004E", "$type": "color", "$description": "Main brand color" },
      "amethyst":       { "$value": "#6C3483", "$type": "color", "$description": "Secondary brand color" },
      "airForceBlue":   { "$value": "#00308F", "$type": "color", "$description": "Navigation and information" },
      "turquoise":      { "$value": "#48D1CC", "$type": "color", "$description": "Accent. Good as a fill, too light to use as text or an outline on white" },
      "turquoiseDeep":  { "$value": "#0B7A75", "$type": "color", "$description": "Darker turquoise for focus rings and links on white (5.2:1)" },
      "turquoiseHover": { "$value": "#35BDB8", "$type": "color" },
      "coolGray":       { "$value": "#9090C0", "$type": "color" },
      "iceGray":        { "$value": "#EBEEEB", "$type": "color" },
      "slate400":       { "$value": "#7B8294", "$type": "color", "$description": "Input borders on white (3.8:1)" },
      "slate600":       { "$value": "#5B6470", "$type": "color", "$description": "Secondary text (5.7:1 on the light surface)" },
      "ink":            { "$value": "#1F1235", "$type": "color", "$description": "Main text on light backgrounds" },
      "white":          { "$value": "#FFFFFF", "$type": "color" },
      "mist":           { "$value": "#F7F8FB", "$type": "color" },
      "line":           { "$value": "#E0E3EB", "$type": "color" },

      "night900":       { "$value": "#0F0133", "$type": "color", "$description": "Dark page background" },
      "night800":       { "$value": "#18083D", "$type": "color", "$description": "Dark surface" },
      "night700":       { "$value": "#241344", "$type": "color", "$description": "Dark raised surface" },
      "night600":       { "$value": "#39245B", "$type": "color", "$description": "Dark divider lines" },
      "night300":       { "$value": "#8F86AD", "$type": "color", "$description": "Dark input borders (5.4:1)" },
      "night100":       { "$value": "#B8B5C8", "$type": "color", "$description": "Dark secondary text" },
      "orchid300":      { "$value": "#C9A0DC", "$type": "color", "$description": "Light purple used for primary actions in dark mode" },
      "orchid200":      { "$value": "#DDBBEA", "$type": "color" },

      "red700":         { "$value": "#B91C1C", "$type": "color" },
      "red400":         { "$value": "#F87171", "$type": "color" },
      "green700":       { "$value": "#15803D", "$type": "color" },
      "green400":       { "$value": "#4ADE80", "$type": "color" },
      "amber700":       { "$value": "#B45309", "$type": "color" },
      "amber400":       { "$value": "#FBBF24", "$type": "color" },
      "amber300":       { "$value": "#FFA94D", "$type": "color", "$description": "Warning highlight (decorative, not for text)" },

      "infoTintLight":    { "$value": "#EAF0FF", "$type": "color" },
      "warningTintLight": { "$value": "#FFF4E5", "$type": "color" },
      "errorTintLight":   { "$value": "#FEECEC", "$type": "color" },
      "successTintLight": { "$value": "#E8F7ED", "$type": "color" },
      "infoTintDark":     { "$value": "#0F2255", "$type": "color" },
      "warningTintDark":  { "$value": "#3A2606", "$type": "color" },
      "errorTintDark":    { "$value": "#3B1220", "$type": "color" },
      "successTintDark":  { "$value": "#0E2F1B", "$type": "color" },
      "info400":          { "$value": "#93B4FF", "$type": "color" }
    },
    "gradient": {
      "primary":    { "$value": ["{core.color.blackberry}", "{core.color.amethyst}"], "$type": "gradient" },
      "accent":     { "$value": ["{core.color.airForceBlue}", "{core.color.turquoise}"], "$type": "gradient" },
      "background": { "$value": ["{core.color.mist}", "{core.color.iceGray}"], "$type": "gradient" }
    }
  },

  "themes": {
    "light": {
      "color": {
        "background": {
          "page":     { "$value": "{core.color.white}", "$type": "color" },
          "surface":  { "$value": "{core.color.mist}", "$type": "color" },
          "elevated": { "$value": "{core.color.white}", "$type": "color" },
          "disabled": { "$value": "{core.color.iceGray}", "$type": "color" }
        },
        "text": {
          "primary":   { "$value": "{core.color.ink}", "$type": "color" },
          "secondary": { "$value": "{core.color.slate600}", "$type": "color" },
          "disabled":  { "$value": "{core.color.slate400}", "$type": "color" },
          "onPrimary": { "$value": "{core.color.white}", "$type": "color" },
          "onAccent":  { "$value": "{core.color.ink}", "$type": "color" },
          "link":      { "$value": "{core.color.blackberry}", "$type": "color" }
        },
        "border": {
          "default": { "$value": "{core.color.line}", "$type": "color", "$description": "Decorative dividers and card edges" },
          "strong":  { "$value": "{core.color.slate400}", "$type": "color", "$description": "Edges of inputs. Needs 3:1 against the page" }
        },
        "action": {
          "primary":   { "background": { "$value": "{core.color.blackberry}", "$type": "color" }, "backgroundHover": { "$value": "{core.color.amethyst}", "$type": "color" }, "text": { "$value": "{core.color.white}", "$type": "color" } },
          "secondary": { "background": { "$value": "{core.color.amethyst}", "$type": "color" },   "backgroundHover": { "$value": "{core.color.blackberry}", "$type": "color" }, "text": { "$value": "{core.color.white}", "$type": "color" } },
          "accent":    { "background": { "$value": "{core.color.turquoise}", "$type": "color" },   "backgroundHover": { "$value": "{core.color.turquoiseHover}", "$type": "color" }, "text": { "$value": "{core.color.ink}", "$type": "color" } }
        },
        "focus": {
          "ring": { "$value": "{core.color.turquoiseDeep}", "$type": "color" },
          "glow": { "$value": "rgba(11, 122, 117, 0.25)", "$type": "color" }
        },
        "navigation": {
          "background": { "$value": "{core.color.airForceBlue}", "$type": "color" },
          "text":       { "$value": "{core.color.white}", "$type": "color" }
        },
        "status": {
          "information": { "text": { "$value": "{core.color.airForceBlue}", "$type": "color" }, "background": { "$value": "{core.color.infoTintLight}", "$type": "color" } },
          "warning":     { "text": { "$value": "{core.color.amber700}", "$type": "color" },     "background": { "$value": "{core.color.warningTintLight}", "$type": "color" } },
          "error":       { "text": { "$value": "{core.color.red700}", "$type": "color" },       "background": { "$value": "{core.color.errorTintLight}", "$type": "color" } },
          "success":     { "text": { "$value": "{core.color.green700}", "$type": "color" },     "background": { "$value": "{core.color.successTintLight}", "$type": "color" } }
        }
      }
    },
    "dark": {
      "color": {
        "background": {
          "page":     { "$value": "{core.color.night900}", "$type": "color" },
          "surface":  { "$value": "{core.color.night800}", "$type": "color" },
          "elevated": { "$value": "{core.color.night700}", "$type": "color" },
          "disabled": { "$value": "{core.color.night700}", "$type": "color" }
        },
        "text": {
          "primary":   { "$value": "{core.color.white}", "$type": "color" },
          "secondary": { "$value": "{core.color.night100}", "$type": "color" },
          "disabled":  { "$value": "{core.color.night300}", "$type": "color" },
          "onPrimary": { "$value": "{core.color.ink}", "$type": "color" },
          "onAccent":  { "$value": "{core.color.ink}", "$type": "color" },
          "link":      { "$value": "{core.color.orchid300}", "$type": "color" }
        },
        "border": {
          "default": { "$value": "{core.color.night600}", "$type": "color" },
          "strong":  { "$value": "{core.color.night300}", "$type": "color" }
        },
        "action": {
          "primary":   { "background": { "$value": "{core.color.orchid300}", "$type": "color" }, "backgroundHover": { "$value": "{core.color.orchid200}", "$type": "color" }, "text": { "$value": "{core.color.ink}", "$type": "color" } },
          "secondary": { "background": { "$value": "{core.color.amethyst}", "$type": "color" },  "backgroundHover": { "$value": "{core.color.orchid300}", "$type": "color" }, "text": { "$value": "{core.color.white}", "$type": "color" } },
          "accent":    { "background": { "$value": "{core.color.turquoise}", "$type": "color" }, "backgroundHover": { "$value": "{core.color.turquoiseHover}", "$type": "color" }, "text": { "$value": "{core.color.ink}", "$type": "color" } }
        },
        "focus": {
          "ring": { "$value": "{core.color.turquoise}", "$type": "color" },
          "glow": { "$value": "rgba(72, 209, 204, 0.30)", "$type": "color" }
        },
        "navigation": {
          "background": { "$value": "{core.color.night700}", "$type": "color" },
          "text":       { "$value": "{core.color.white}", "$type": "color" }
        },
        "status": {
          "information": { "text": { "$value": "{core.color.info400}", "$type": "color" },  "background": { "$value": "{core.color.infoTintDark}", "$type": "color" } },
          "warning":     { "text": { "$value": "{core.color.amber400}", "$type": "color" }, "background": { "$value": "{core.color.warningTintDark}", "$type": "color" } },
          "error":       { "text": { "$value": "{core.color.red400}", "$type": "color" },   "background": { "$value": "{core.color.errorTintDark}", "$type": "color" } },
          "success":     { "text": { "$value": "{core.color.green400}", "$type": "color" }, "background": { "$value": "{core.color.successTintDark}", "$type": "color" } }
        }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "primary": { "$value": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif", "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "xs":  { "$value": "0.75rem",  "$type": "dimension", "$description": "12px. Metadata and timestamps" },
      "sm":  { "$value": "0.875rem", "$type": "dimension", "$description": "14px. Helper text and labels" },
      "md":  { "$value": "1rem",     "$type": "dimension", "$description": "16px. Body text and form inputs" },
      "lg":  { "$value": "1.25rem",  "$type": "dimension", "$description": "20px. Card titles" },
      "xl":  { "$value": "1.5rem",   "$type": "dimension", "$description": "24px. Section headings" },
      "2xl": { "$value": "2rem",     "$type": "dimension", "$description": "32px. Page headings" },
      "3xl": { "$value": "2.5rem",   "$type": "dimension", "$description": "40px. Hero headings" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2,  "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.75, "$type": "number" }
    },
    "textStyle": {
      "hero":           { "fontSize": "{typography.fontSize.3xl}", "fontWeight": "{typography.fontWeight.bold}",     "lineHeight": "{typography.lineHeight.tight}" },
      "pageHeading":    { "fontSize": "{typography.fontSize.2xl}", "fontWeight": "{typography.fontWeight.bold}",     "lineHeight": "{typography.lineHeight.tight}" },
      "sectionHeading": { "fontSize": "{typography.fontSize.xl}",  "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.tight}" },
      "cardTitle":      { "fontSize": "{typography.fontSize.lg}",  "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.normal}" },
      "body":           { "fontSize": "{typography.fontSize.md}",  "fontWeight": "{typography.fontWeight.regular}",  "lineHeight": "{typography.lineHeight.normal}" },
      "label":          { "fontSize": "{typography.fontSize.sm}",  "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.normal}" },
      "helper":         { "fontSize": "{typography.fontSize.sm}",  "fontWeight": "{typography.fontWeight.regular}",  "lineHeight": "{typography.lineHeight.normal}" },
      "caption":        { "fontSize": "{typography.fontSize.xs}",  "fontWeight": "{typography.fontWeight.regular}",  "lineHeight": "{typography.lineHeight.normal}" }
    }
  },

  "spacing": {
    "$description": "Every space is a multiple of 4px. The key is the multiplier: space.4 = 4 x 4 = 16px.",
    "1":  { "$value": "4px",  "$type": "dimension", "$description": "Tiny gaps, icon alignment" },
    "2":  { "$value": "8px",  "$type": "dimension", "$description": "Label to input" },
    "3":  { "$value": "12px", "$type": "dimension", "$description": "Button vertical padding" },
    "4":  { "$value": "16px", "$type": "dimension", "$description": "Between related elements" },
    "6":  { "$value": "24px", "$type": "dimension", "$description": "Between cards and sections, button horizontal padding" },
    "8":  { "$value": "32px", "$type": "dimension", "$description": "Card padding" },
    "12": { "$value": "48px", "$type": "dimension", "$description": "Major section spacing" },
    "16": { "$value": "64px", "$type": "dimension", "$description": "Large page-level spacing" }
  },

  "size": {
    "touchTarget": { "$value": "44px", "$type": "dimension", "$description": "Smallest tappable height for buttons and inputs" },
    "inputHeight": { "$value": "48px", "$type": "dimension" },
    "iconSm":      { "$value": "16px", "$type": "dimension" },
    "iconMd":      { "$value": "20px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0px",    "$type": "dimension" },
    "xs":   { "$value": "2px",    "$type": "dimension" },
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "2xl":  { "$value": "24px",   "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },

  "shadow": {
    "cardHover": { "$value": "0 8px 24px rgba(15, 1, 51, 0.12)", "$type": "shadow" }
  },

  "breakpoint": {
    "sm": { "$value": "640px",  "$type": "dimension", "$description": "Large phones" },
    "md": { "$value": "768px",  "$type": "dimension", "$description": "Tablets" },
    "lg": { "$value": "1024px", "$type": "dimension", "$description": "Laptops" },
    "xl": { "$value": "1280px", "$type": "dimension", "$description": "Desktops" }
  },

  "motion": {
    "duration": { "$value": "200ms", "$type": "duration" },
    "easing":   { "$value": "ease",  "$type": "cubicBezier" },
    "buttonHoverLift": { "$value": "-2px", "$type": "dimension" },
    "cardHoverLift":   { "$value": "-4px", "$type": "dimension" },
    "spinnerDuration": { "$value": "800ms", "$type": "duration" },
    "reducedMotion": "When the user's device asks for reduced motion, remove the lift effects and keep only color changes."
  },

  "component": {
    "button": {
      "fontSize":     { "$value": "{typography.fontSize.sm}", "$type": "dimension" },
      "fontWeight":   { "$value": "{typography.fontWeight.semibold}", "$type": "fontWeight" },
      "borderRadius": { "$value": "{radius.md}", "$type": "dimension" },
      "minHeight":    { "$value": "{size.touchTarget}", "$type": "dimension" },
      "paddingY":     { "$value": "{spacing.3}", "$type": "dimension" },
      "paddingX":     { "$value": "{spacing.6}", "$type": "dimension" },
      "variants": {
        "primary":   { "background": "{color.action.primary.background}",   "text": "{color.action.primary.text}",   "hoverBackground": "{color.action.primary.backgroundHover}" },
        "secondary": { "background": "{color.action.secondary.background}", "text": "{color.action.secondary.text}", "hoverBackground": "{color.action.secondary.backgroundHover}" },
        "accent":    { "background": "{color.action.accent.background}",    "text": "{color.action.accent.text}",    "hoverBackground": "{color.action.accent.backgroundHover}" }
      },
      "states": {
        "hover":    { "transform": "translateY({motion.buttonHoverLift})", "transition": "background-color {motion.duration} {motion.easing}, transform {motion.duration} {motion.easing}" },
        "focus":    { "outline": "2px solid {color.focus.ring}", "outlineOffset": "2px" },
        "disabled": { "background": "{color.background.disabled}", "text": "{color.text.disabled}", "cursor": "not-allowed" },
        "loading":  { "opacity": 0.8, "cursor": "progress", "disabled": true, "label": "Replace the label with what is happening, for example Logging in…", "spinnerSize": "{size.iconMd}" }
      }
    },
    "input": {
      "fontSize":     { "$value": "{typography.fontSize.md}", "$type": "dimension", "$description": "16px stops iPhones zooming in when the field is tapped" },
      "height":       { "$value": "{size.inputHeight}", "$type": "dimension" },
      "borderRadius": { "$value": "{radius.md}", "$type": "dimension" },
      "background":   "{color.background.page}",
      "text":         "{color.text.primary}",
      "placeholder":  "{color.text.secondary}",
      "border":       "1px solid {color.border.strong}",
      "label":        { "textStyle": "label", "gapToInput": "{spacing.2}" },
      "helper":       { "textStyle": "helper", "color": "{color.text.secondary}" },
      "states": {
        "focus":    { "border": "1px solid {color.focus.ring}", "boxShadow": "0 0 0 3px {color.focus.glow}", "transition": "border-color {motion.duration} {motion.easing}, box-shadow {motion.duration} {motion.easing}" },
        "error":    { "border": "2px solid {color.status.error.text}", "messageColor": "{color.status.error.text}", "messageHasIcon": true, "ariaInvalid": true },
        "disabled": { "background": "{color.background.disabled}", "text": "{color.text.disabled}", "cursor": "not-allowed" },
        "loading":  { "treatAs": "disabled", "reason": "Lock fields while the form is being sent" }
      }
    },
    "card": {
      "background":   "{color.background.elevated}",
      "border":       "1px solid {color.border.default}",
      "borderRadius": { "$value": "{radius.lg}", "$type": "dimension" },
      "padding":      { "$value": "{spacing.8}", "$type": "dimension" },
      "states": {
        "hover": { "transform": "translateY({motion.cardHoverLift})", "boxShadow": "{shadow.cardHover}", "transition": "transform {motion.duration} {motion.easing}, box-shadow {motion.duration} {motion.easing}" }
      }
    },
    "statusMessage": {
      "borderRadius": { "$value": "{radius.md}", "$type": "dimension" },
      "padding":      { "$value": "{spacing.4}", "$type": "dimension" },
      "textStyle":    "label",
      "rule":         "Always pair the color with an icon and words, so color is never the only signal.",
      "variants": {
        "information": { "text": "{color.status.information.text}", "background": "{color.status.information.background}" },
        "warning":     { "text": "{color.status.warning.text}",     "background": "{color.status.warning.background}" },
        "error":       { "text": "{color.status.error.text}",       "background": "{color.status.error.background}" },
        "success":     { "text": "{color.status.success.text}",     "background": "{color.status.success.background}" }
      }
    },
    "navigation": {
      "background": "{color.navigation.background}",
      "text":       "{color.navigation.text}"
    }
  },

  "accessibility": {
    "textContrastMin": "4.5:1 for normal text, checked for every text and background pair in both themes",
    "uiContrastMin": "3:1 for input borders, focus rings and icons",
    "focusRule": "Every clickable element shows a visible focus ring when reached with the keyboard",
    "touchTargetMin": "{size.touchTarget}"
  }
}