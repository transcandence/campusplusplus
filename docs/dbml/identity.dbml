// Identity Service — campus_identity
// Introspected from the running compose-postgres-1 container (PostgreSQL 17).
// Source: pg_dump --schema-only from inside the container.

Project campus_identity {
  database_type: 'PostgreSQL'
  Note: 'Identity Service database (users, auth sessions, profiles, tenancy campuses, outbox).'
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum affiliation {
  "1337"
  ABS
  FGSES
  SHBM
  SAS
  CC
  AEM
  um6p
}

Enum gender {
  male
  female
  other
}

Enum user_role {
  student
  staff
  admin
  guest
  worker
}

Enum user_status {
  pending_verification
  active
  suspended
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

Table campuses {
  id integer [pk, increment]
  code varchar(30) [not null, unique, note: 'Format: ^[a-z0-9_-]+$']
  name varchar(60) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id integer [pk, increment]
  first_name varchar(30) [not null]
  last_name varchar(30) [not null]
  email citext [null, unique, note: 'case-insensitive']
  phone_number varchar(20) [null, unique]
  birthday date [null]
  affiliation affiliation [not null]
  role user_role [not null, default: 'student']
  gender gender [null]
  password_hash text [not null]
  nationality varchar(60) [null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  status user_status [not null, default: 'pending_verification']
  campus_id integer [not null]

  Note: 'CHECK: email IS NOT NULL OR phone_number IS NOT NULL (at least one contact).'
}

Table profiles {
  id integer [pk, increment]
  user_id integer [not null, unique]
  image text [null]
  nickname varchar(30) [not null, unique]
  bio varchar(1024) [null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table settings {
  id integer [pk, increment]
  user_id integer [not null, unique]
  theme varchar(30) [not null, default: 'light', note: 'light | dark']
  language varchar(30) [not null, default: 'english', note: 'arabic | english | french']
  notification_email boolean [not null, default: true]
  two_factor_enabled boolean [not null, default: false]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table sessions {
  id integer [pk, increment]
  user_id integer [not null]
  ip_address inet [not null]
  user_agent text [null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  token_hash bytea [not null, unique, note: 'SHA-256 of the opaque refresh token. 32 bytes. Never store the token itself.']
  revoked_at timestamptz [null, note: 'NULL = active. Set on logout, rotation, suspend. Soft delete; GC removes after reuse window.']
  last_used_at timestamptz [null, note: 'Updated on refresh only (~every 10 min), not on every request.']
  family_id uuid [not null, default: `gen_random_uuid()`]
  rotated_at timestamptz [null]
  replaced_by integer [null]

  Note: 'CHECK: expires_at > created_at.'
}

Table outbox_events {
  id bigint [pk, increment]
  aggregate_id bigint [not null]
  event_type varchar(60) [not null]
  payload jsonb [not null]
  status varchar(20) [not null, default: 'pending', note: 'pending | sent | failed']
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz [null]
}

Table schema_migrations {
  version bigint [pk]
  dirty boolean [not null]
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: profiles.user_id > users.id [delete: cascade]

Ref: settings.user_id > users.id [delete: cascade]

Ref: sessions.user_id > users.id [delete: cascade]

Ref: sessions.replaced_by > sessions.id [delete: no action]

Ref: users.campus_id > campuses.id [delete: restrict]
