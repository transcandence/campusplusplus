# --- Service ---
ENV=dev
HTTP_ADDR=:xxxx
LOG_LEVEL=info

# --- Database ---
# Matches infra/compose/docker-compose.yml and initdb/01-databases.sql.
# The housing service owns the "housing" database.
#
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=disable
DB_MAX_CONNS=10

MIGRATIONS_DIR=xxxxxxxxx
