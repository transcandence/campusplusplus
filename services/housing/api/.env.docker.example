ENV=xxx
HTTP_ADDR=xxxx
LOG_LEVEL=xxxx

# --- Database ---
# Matches infra/compose/docker-compose.yml and initdb/01-databases.sql.
# The housing service owns the "housing" database.
#
DB_MAX_CONNS=xxxx

# The Dockerfile copies migrations/ into the image; cmd/migrate reads them
# from here rather than assuming a working directory.
MIGRATIONS_DIR=/app/migrations
