# --- Service ---
ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Database ---
# The identity service owns the "identity" database.
DB_MAX_CONNS=10

# --- JWT ---
# Access = 10 minutes, refresh = 30 days (must match the OpenAPI contract).
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=720h
JWT_ISSUER=campus-identity
JWT_AUDIENCE=campus-api

# --- Sessions ---
MAX_ACTIVE_SESSIONS=10
SESSION_RETENTION=720h
SESSION_CLEANUP_INTERVAL=1h

# --- Rate limiting (not implemented yet; reserved for the future middleware) ---
RATE_LIMIT_LOGIN_PER_MIN=10

MIGRATIONS_DIR=./migrations
