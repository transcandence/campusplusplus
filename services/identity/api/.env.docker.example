# --- Service ---
ENV=dev
HTTP_ADDR=:xxxx
LOG_LEVEL=info

# --- Database ---
# The identity service owns the "identity" database.
DB_MAX_CONNS=x0

# --- JWT ---
# These MUST match services/identity/contracts/openapi.yaml: access  = 6xxs (xxm) and refresh = x2xh (x0d)
JWT_ACCESS_TTL=x0m
JWT_REFRESH_TTL=x2xh
JWT_ISSUER=xxxxxxxxxxx
JWT_AUDIENCE=xxxxxxxxxxx

# --- Rate limiting (loose; spec only promises 429 + Retry-After) ---
RATE_LIMIT_LOGIN_PER_MIN=x0

MIGRATIONS_DIR=xxxxxxxxx
