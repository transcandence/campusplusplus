# --- Service ---
ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Database ---
# Matches infra/compose/docker-compose.yml and initdb/01-databases.sql.
# The identity service owns the "identity" database.
DATABASE_URL=postgres://identity:identity@localhost:5432/identity?sslmode=disable
DB_MAX_CONNS=10

# --- JWT ---
# MUST be at least 32 bytes. Generate with: openssl rand -base64 32  In production this comes from a secret manager, never a file.
JWT_SECRET=change-me-please-32-bytes-minimum-xxxxx

# These MUST match services/identity/contracts/openapi.yaml: access  = 600s (10m) and refresh = 720h (30d)
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=720h
JWT_ISSUER=campus-identity
JWT_AUDIENCE=campus-api

# --- Rate limiting (loose; spec only promises 429 + Retry-After) ---
RATE_LIMIT_LOGIN_PER_MIN=10

MIGRATIONS_DIR=./migrations
