# --- Service ---
ENV=dev
HTTP_ADDR=:xxxx
LOG_LEVEL=info

# --- Database ---
# Matches infra/compose/docker-compose.yml and initdb/01-databases.sql.
# The identity service owns the "identity" database.
DB_MAX_CONNS=10

# --- JWT ---
# These MUST match services/identity/contracts/openapi.yaml: access  = 600s (10m) and refresh = 720h (30d)
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=720h
JWT_ISSUER=xxxxxxxxxxx
JWT_AUDIENCE=xxxxxxxxxxx

# --- Rate limiting (loose; spec only promises 429 + Retry-After) ---
RATE_LIMIT_LOGIN_PER_MIN=10

MIGRATIONS_DIR=xxxxxxxxx
