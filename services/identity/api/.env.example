# --- Service ---
ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Database ---
# Matches infra/compose/docker-compose.yml and initdb/01-databases.sql.
# The identity service owns the "identity" database.
DB_MAX_CONNS=10

# Access = 10 minutes, refresh = 30 days (must match the OpenAPI contract).
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=720h
JWT_ISSUER=campus-identity
JWT_AUDIENCE=campus-api

JWT_PRIVATE_KEY_PATH=private.pem
JWT_PUBLIC_KEY_PATH=public.pem

# --- Sessions ---
# Maximum number of active sessions per user; oldest sessions are revoked
# first when the limit is exceeded.
MAX_ACTIVE_SESSIONS=10
# How long expired/revoked sessions are kept for auditing before deletion.
SESSION_RETENTION=720h
# How often the worker runs the cleanup batch.
SESSION_CLEANUP_INTERVAL=1h

# --- Rate limiting (not implemented yet; reserved for the future middleware) ---
RATE_LIMIT_LOGIN_PER_MIN=10

MIGRATIONS_DIR=./migrations
